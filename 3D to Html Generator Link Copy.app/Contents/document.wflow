				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># 1. รับชื่อไฟล์จากหน้าต่างพิมพ์ข้อความ
read newModel

# 2. ย้ายตำแหน่งไปที่โฟลเดอร์ Repository ของคุณ (***ต้องแก้ไขที่อยู่ให้ตรงกับเครื่องคุณ***)
# ตัวอย่าง: cd /Users/macgra/Documents/GitHub/3D-model
cd "ที่อยู่โฟลเดอร์ GitHub ของคุณ"

# 3. ตรวจสอบว่ามีโฟลเดอร์ .git หรือไม่
if [ ! -d ".git" ]; then
    osascript -e 'display notification "Error: ไม่พบโฟลเดอร์ .git ในที่อยู่ที่ระบุ" with title "3D Generator"'
    exit 1
fi

# 4. แยกชื่อไฟล์เพื่อตั้งชื่อ .html
fileName="${newModel%.*}"
outputFile="${fileName}.html"

# 5. สร้างไฟล์ HTML (จัดรูปแบบสวยงามเหมือนฝั่งซ้าย)
cat &lt;&lt;EOF &gt; "$outputFile"
&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
    &lt;meta charset="UTF-8"&gt;
    &lt;meta name="viewport" content="width=device-width, initial-scale=1.0"&gt;
    &lt;title&gt;Designdee 3D Preview&lt;/title&gt;
    &lt;script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.3.0/model-viewer.min.js"&gt;&lt;/script&gt;
    &lt;style&gt;
        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            overflow: hidden; background-color: #ffffff;
        }
        .logo-container {
            position: absolute; top: 20px; left: 20px;
            z-index: 1000; pointer-events: none;
        }
        .logo-container img {
            width: 150px; height: auto;
            filter: drop-shadow(0px 2px 4px rgba(0,0,0,0.2));
        }
        model-viewer {
            width: 100%; height: 100vh;
            --poster-color: transparent;
        }
        #ar-button {
            background-color: #ffffff; border-radius: 30px;
            border: 1px solid #dadce0; bottom: 30px; left: 50%;
            position: absolute; transform: translateX(-50%);
            padding: 14px 28px; font-family: sans-serif;
            font-size: 16px; font-weight: bold; color: #1a73e8;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15); cursor: pointer; z-index: 1000;
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;div class="logo-container"&gt;
        &lt;img src="RCIlogo.png" alt="Company Logo"&gt;
    &lt;/div&gt;
    &lt;model-viewer
        src="$newModel"
        ar ar-modes="webxr scene-viewer quick-look"
        camera-controls tone-mapping="neutral"
        shadow-intensity="1" auto-rotate touch-action="pan-y"
        alt="3D Model Preview"&gt;
        &lt;button slot="ar-button" id="ar-button"&gt;📦 View in AR&lt;/button&gt;
    &lt;/model-viewer&gt;
&lt;/body&gt;
&lt;/html&gt;
EOF

# 6. คัดลอกลิงก์ลง Clipboard
encodedName=$(echo "$outputFile" | sed 's/ /%20/g')
echo "https://graphicroyalcan.github.io/3D-model/$encodedName" | pbcopy

# 7. อัปโหลดขึ้น GitHub
git add .
git commit -m "Auto-upload: $outputFile"
git push origin main

if [ $? -eq 0 ]; then
    echo "สำเร็จ: สร้างไฟล์และอัปโหลดแล้ว (คัดลอกลิงก์ให้แล้ว)"
else
    echo "แจ้งเตือน: อัปโหลดไม่สำเร็จ แต่สร้างไฟล์เรียบร้อย"
fi</string>
